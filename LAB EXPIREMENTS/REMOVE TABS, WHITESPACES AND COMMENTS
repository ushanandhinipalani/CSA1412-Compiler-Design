#include <stdio.h>

int main()
{
    FILE *fp;
    char c, d;

    fp = fopen("input.c", "r");

    if (fp == NULL)
    {
        printf("File not found");
        return 0;
    }

    while ((c = fgetc(fp)) != EOF)
    {
        if (c == ' ' || c == '\t' || c == '\n')
            continue;

        if (c == '/')
        {
            d = fgetc(fp);

            if (d == '/')
            {
                while ((c = fgetc(fp)) != EOF && c != '\n');
                continue;
            }
            else if (d == '*')
            {
                while ((c = fgetc(fp)) != EOF)
                {
                    if (c == '*' && (d = fgetc(fp)) == '/')
                        break;
                }
                continue;
            }
            else
            {
                putchar(c);
                if (d != EOF)
                    ungetc(d, fp);
                continue;
            }
        }

        putchar(c);
    }

    fclose(fp);
    return 0;
}
