#include <stdio.h>
#include <string.h>

int main()
{
    char nt, a[20], b[20];
    int i = 0;

    printf("Enter non-terminal: ");
    scanf(" %c", &nt);

    printf("Enter first production: ");
    scanf("%s", a);

    printf("Enter second production: ");
    scanf("%s", b);

    while (a[i] == b[i] && a[i] != '\0')
        i++;

    printf("\nAfter left factoring:\n");
    printf("%c -> ", nt);

    for (int j = 0; j < i; j++)
        printf("%c", a[j]);

    printf("%c'\n", nt);
    printf("%c' -> %s | %s\n", nt, a + i, b + i);

    return 0;
}
