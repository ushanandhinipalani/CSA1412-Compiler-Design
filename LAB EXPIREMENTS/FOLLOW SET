#include <stdio.h>
#include <string.h>
#include <ctype.h>

char p[10][10];
int n;

int main()
{
    int i, j, k;
    char c;

    printf("Enter number of productions: ");
    scanf("%d", &n);

    printf("Enter productions (A=abc):\n");
    for (i = 0; i < n; i++)
        scanf("%s", p[i]);

    printf("Enter non-terminal: ");
    scanf(" %c", &c);

    printf("FOLLOW(%c) = { ", c);

    if (p[0][0] == c)
        printf("$ ");

    for (i = 0; i < n; i++)
    {
        for (j = 2; p[i][j] != '\0'; j++)
        {
            if (p[i][j] == c)
            {
                if (p[i][j + 1] != '\0')
                {
                    if (!isupper(p[i][j + 1]))
                        printf("%c ", p[i][j + 1]);
                }
                else if (p[i][0] != c)
                    printf("$ ");
            }
        }
    }

    printf("}");
    return 0;
}
